PORT=3001

# Comma-separated allowed frontend origins (scheme + host, no trailing slash).
# On Render, add your Vercel URL here, for example:
# CORS_ORIGIN=http://localhost:5173,https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Optional. Defaults to ../frontend/dist next to this backend folder.
# FRONTEND_DIST=../frontend/dist

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM="MSGR. F. MUBILIGI CATHOLIC TSS <certificates@example.com>"
